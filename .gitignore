draft_app/current_nomination.json
draft_app/bridge_unresolved.json
draft_app/draft_room_dump_*.html
draft_app/*.tmp
# ESPN injury snapshot and the manual expected-games overrides (personal, regenerated)
draft_app/injuries.json
draft_app/availability_overrides.json

